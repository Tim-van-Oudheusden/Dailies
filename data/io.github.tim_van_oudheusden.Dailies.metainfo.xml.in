<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2026 Tim van Oudheusden -->
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Dailies</name>
  <summary>Play your daily guessing games</summary>
  <description>
    <p>
      Dailies gathers daily guessing games like Wordle, Connections and Worldle in one window, sorted into ten
      categories from words and logic to music, movies and geography. Popular and Trending shelves, refreshed every
      week, show which games are popular right now and which are on the rise. Star the games you play every day to keep
      them together in Favorites.
    </p>
    <p>
      Games open in a built-in browser that keeps your streaks between sessions, or in your default web browser if you
      prefer. Dailies needs no account and collects no data: your favorites stay on your device, and the app only
      downloads the game list and the game pages you open.
    </p>
  </description>

  <developer id="io.github.tim_van_oudheusden">
    <name translate="no">Tim van Oudheusden</name>
  </developer>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <translation type="gettext">dailies</translation>

  <url type="homepage">https://github.com/Tim-van-Oudheusden/Dailies</url>
  <url type="bugtracker">https://github.com/Tim-van-Oudheusden/Dailies/issues</url>
  <url type="vcs-browser">https://github.com/Tim-van-Oudheusden/Dailies</url>
  <url type="contribute">https://github.com/Tim-van-Oudheusden/Dailies/blob/main/CONTRIBUTING.md</url>

  <!-- Blue 1 and Blue 5 from the GNOME palette, the icon's header colours (docs/research/logo-icon.md §8). -->
  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <!--
    Dailies itself has no ads, purchases, chat or accounts, but the built-in browser shows the games' own websites and
    lets the user navigate from there, so the rating covers what the catalog's sites expose: banner ads, paid
    subscriptions (NYT Spelling Bee, GeoGuessr), LinkedIn's messaging next to its games, and ad networks that receive
    unique identifiers from the game pages.
  -->
  <content_rating type="oars-1.1">
    <content_attribute id="money-advertising">moderate</content_attribute>
    <content_attribute id="money-purchasing">intense</content_attribute>
    <content_attribute id="social-chat">moderate</content_attribute>
    <content_attribute id="social-info">intense</content_attribute>
  </content_rating>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Tim-van-Oudheusden/Dailies/v0.1.0/data/screenshots/1.png</image>
      <caption>Your favorite daily games together in one place</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Tim-van-Oudheusden/Dailies/v0.1.0/data/screenshots/2.png</image>
      <caption>The games that are popular this week</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Tim-van-Oudheusden/Dailies/v0.1.0/data/screenshots/3.png</image>
      <caption>Playing a game in the built-in browser</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Tim-van-Oudheusden/Dailies/v0.1.0/data/screenshots/4.png</image>
      <caption>Word games in the dark style</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.2.0" date="2026-10-16">
      <description translate="no">
        <p>The game list now grows between releases.</p>
        <ul>
          <li>Two new games, Phoodle and Angle, the first added through the “Add a game” form on GitHub</li>
          <li>Suggest a game with that form: once a maintainer approves it, Dailies picks it up from the game list on GitHub Pages the next time it refreshes, without a new release</li>
          <li>The Popular and Trending shelves are recomputed every Monday and reach Dailies the same way</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-16">
      <description translate="no">
        <p>The first release of Dailies.</p>
        <ul>
          <li>Browse more than a hundred daily guessing games in ten categories</li>
          <li>See the games that are popular and trending this week</li>
          <li>Star games to keep them in Favorites, with undo, and put them in your own order</li>
          <li>Mark the games you have played as done today, by hand or automatically</li>
          <li>Search the current section with Ctrl+F, which forgives a typo in longer searches</li>
          <li>Play in the built-in browser, which keeps your game progress, in your default browser, or through a command of your choice</li>
          <li>Choose how games open and set the built-in browser’s website data, cookie and tracking prevention options in Preferences</li>
          <li>Export your favorites to a file and import them on another computer</li>
          <li>Hide games in languages other than your own</li>
          <li>Works offline with a bundled copy of the game list and updates it from GitHub</li>
          <li>Music games play sound inside Dailies</li>
          <li>Available in English and Dutch</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
