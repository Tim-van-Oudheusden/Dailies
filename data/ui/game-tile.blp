using Gtk 4.0;

template $DailiesGameTile: Overlay {
  // Narrow enough for two columns at 360 px, wide enough for the caption row and the star beside the glyph.
  width-request: 160;

  // The whole card is the "open" button for the pointer; the grid's item takes the keyboard focus instead of it.
  // The star is an overlay, so a button is never nested in a button.
  child: Button open_button {
    can-focus: false;
    clicked => $on_open_clicked();

    // The description, "Geography · Easy", is set from code: it follows the game.
    accessibility {
      labelled-by: title_label;
    }

    styles [
      "card",
      "game-tile",
    ]

    child: Box {
      orientation: vertical;
      spacing: 6;

      // The category glyph on its tint. A game with an icon shows the icon on the tint instead and keeps the glyph as a
      // badge in the corner, so the category stays scannable; the square keeps its size. Both are set from code.
      Overlay {
        halign: start;
        margin-bottom: 6;

        child: Image glyph {
          pixel-size: 32;
          width-request: 64;
          height-request: 64;
          accessible-role: presentation;
        };

        [overlay]
        Image game_icon {
          pixel-size: 40;
          visible: false;
          can-target: false;
          accessible-role: presentation;
        }

        [overlay]
        Image category_badge {
          pixel-size: 12;
          visible: false;
          halign: end;
          valign: end;
          can-target: false;
          accessible-role: presentation;
        }
      }

      Label title_label {
        label: bind template.game as <$DailiesGameObject>.name;
        ellipsize: end;
        xalign: 0;

        styles [
          "heading",
        ]
      }

      Box {
        spacing: 6;

        Label category_label {
          label: bind template.game as <$DailiesGameObject>.category-label;
          ellipsize: end;
          xalign: 0;
          hexpand: true;

          styles [
            "caption",
            "dimmed",
          ]
        }

        // The pill carries text, not just a colour; its colour class is set from code.
        Label difficulty_label {
          label: bind template.game as <$DailiesGameObject>.difficulty-label;
          valign: center;

          styles [
            "caption-heading",
            "difficulty-badge",
          ]
        }
      }

      // A broken or retired favourite stays in Favorites, marked with this pill.
      Label unavailable_label {
        label: _("Unavailable");
        visible: false;
        halign: start;

        styles [
          "caption-heading",
          "unavailable-badge",
        ]
      }

      // A game marked as done today: a check with its meaning in words. The rest of the card is dimmed (style.css)
      // while the "done" class is on it; both are set from code.
      Box done_badge {
        spacing: 4;
        visible: false;
        halign: start;

        Image {
          icon-name: "object-select-symbolic";
          accessible-role: presentation;
        }

        Label done_label {
          label: _("Done today");
        }

        styles [
          "caption-heading",
          "done-badge",
        ]
      }
    };
  };

  // Always shown, not only on hover, so touch and keyboard users reach it too. Its icon and tooltip follow it in code.
  [overlay]
  ToggleButton favorite_button {
    halign: end;
    valign: start;
    margin-top: 12;
    margin-end: 12;
    active: bind template.favorite bidirectional;

    accessibility {
      label: _("Favorite");
    }

    styles [
      "circular",
      "osd",
    ]
  }

  // While a favourite is dragged over this one in Favorites, a bar on the side it will be dropped; set from code.
  [overlay]
  Box drop_indicator {
    visible: false;
    can-target: false;
    halign: start;
    width-request: 4;
    margin-top: 6;
    margin-bottom: 6;
    accessible-role: presentation;

    styles [
      "drop-indicator",
    ]
  }
}
