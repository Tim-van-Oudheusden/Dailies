using Gtk 4.0;
using Adw 1;

template $DailiesPreferencesDialog: Adw.PreferencesDialog {
  search-enabled: true;

  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Opening games");
      description: _("Games open inside Dailies by default. You can always open the current game in your browser from its menu.");

      // The model is filled in Python: only the choices this installation can do are offered.
      Adw.ComboRow open_mode_row {
        title: _("Open games");
      }

      // Only shown while "Custom command" is chosen; that choice is only offered with host access.
      Adw.EntryRow command_row {
        title: _("Command");
        show-apply-button: true;
        visible: false;
        apply => $on_command_applied();

        styles [
          "monospace",
        ]
      }

      // Only shown inside Flatpak, where the custom command needs host access the user grants.
      Label custom_help_label {
        label: _("Custom command runs a command of your choice, such as a particular browser, outside the sandbox. It needs host access, a sandbox escape you grant yourself with flatpak override. <a href='https://github.com/Tim-van-Oudheusden/Dailies#custom-browser-command'>How to grant it and the risks</a>");
        use-markup: true;
        wrap: true;
        xalign: 0;
        margin-top: 12;

        styles [
          "dimmed",
        ]
      }
    }

    Adw.PreferencesGroup browser_group {
      title: _("Built-in browser");

      // Off by default; dailies/core/done_today.py sets the minute (AUTO_MARK_SECONDS).
      Adw.SwitchRow auto_done_row {
        title: _("Mark games as done automatically");
        subtitle: _("After a game has been open here for a minute");
      }

      Adw.SwitchRow clear_on_exit_row {
        title: _("Clear website data on exit");
      }

      // The order of each combo row's choices matches its nicks in dailies/ui/preferences.py.
      Adw.ExpanderRow browser_options_row {
        title: _("Privacy and compatibility");
        subtitle: _("Website data, cookies, tracking prevention and rendering");

        Adw.ComboRow session_isolation_row {
          title: _("Website data");
          subtitle: _("Switching does not move signed-in sessions. Games will need to sign in again");

          model: StringList {
            strings [
              _("Shared by all games"),
              _("Separate for each game"),
            ]
          };
        }

        Adw.ComboRow cookie_policy_row {
          title: _("Accept cookies");
          subtitle: _("Some games sign in through other sites and need third-party cookies");

          model: StringList {
            strings [
              _("Always"),
              _("Not from third parties"),
              _("Never"),
            ]
          };
        }

        Adw.SwitchRow itp_row {
          title: _("Intelligent tracking prevention");
          subtitle: _("Limits cross-site tracking; third-party cookies then follow its rules");
        }

        Adw.SwitchRow hardware_acceleration_row {
          title: _("Hardware acceleration");
          subtitle: _("Turn off if games show rendering glitches");
        }

        // For compatibility fixes only: empty keeps the browser's own user agent.
        Adw.EntryRow user_agent_row {
          title: _("Custom user agent (leave empty)");
          show-apply-button: true;
          apply => $on_user_agent_applied();

          styles [
            "monospace",
          ]
        }

        Adw.SwitchRow developer_extras_row {
          title: _("Web inspector");
          subtitle: _("Adds Inspect Element to the page's context menu");
        }
      }

      Adw.ButtonRow clear_row {
        title: _("Clear website data…");
        activated => $on_clear_activated();

        styles [
          "destructive-action",
        ]
      }
    }

    Adw.PreferencesGroup {
      title: _("Appearance");

      // Hides only the corner badge: a game without an icon of its own always shows its category glyph instead.
      Adw.SwitchRow category_badge_row {
        title: _("Category badge on game icons");
        subtitle: _("Games without an icon always show their category");
      }
    }

    Adw.PreferencesGroup {
      title: _("Catalog");

      Adw.ActionRow last_updated_row {
        title: _("Last updated");

        [suffix]
        Button {
          icon-name: "view-refresh-symbolic";
          tooltip-text: _("Refresh Game List");
          valign: center;
          action-name: "app.refresh";

          styles [
            "flat",
          ]
        }

        styles [
          "property",
        ]
      }

      Adw.SwitchRow show_other_languages_row {
        title: _("Show games in other languages");
        subtitle: _("Games in languages other than your system language");
      }
    }
  }
}
