using Gtk 4.0;
using Adw 1;

template $DailiesWindow: Adw.ApplicationWindow {
  title: _("Dailies");
  default-width: 1100;
  default-height: 760;
  width-request: 360;
  height-request: 294;

  // When several breakpoints match, the last one applies: the narrowest goes last.
  Adw.Breakpoint {
    condition ("max-width: 900sp")

    setters {
      grid_view.max-columns: 3;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 500sp")

    setters {
      split_view.collapsed: true;
      sidebar.mode: page;
      grid_view.max-columns: 2;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    Adw.NavigationView navigation_view {
      Adw.NavigationPage {
        tag: "library";
        title: _("Dailies");

        Adw.NavigationSplitView split_view {
          min-sidebar-width: 200;
          max-sidebar-width: 280;
          sidebar-width-fraction: 0.22;

          sidebar: Adw.NavigationPage {
            title: _("Dailies");

            Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [end]
                MenuButton primary_menu_button {
                  primary: true;
                  icon-name: "open-menu-symbolic";
                  tooltip-text: _("Main Menu");
                  menu-model: primary_menu;
                }
              }

              content: Adw.Sidebar sidebar {
                activated => $on_sidebar_activated();

                Adw.SidebarSection {
                  Adw.SidebarItem favorites_item {
                    title: _("Favorites");
                    icon-name: "dailies-starred-symbolic";
                  }
                }

                Adw.SidebarSection {
                  title: _("This Week");

                  suffix: Label week_label {
                    // The stale variant is long: it wraps rather than squeezing the section title.
                    wrap: true;
                    justify: right;
                    xalign: 1;

                    styles [
                      "caption",
                      "dimmed",
                    ]
                  };

                  Adw.SidebarItem popular_item {
                    title: _("Popular");
                    icon-name: "dailies-popular-symbolic";
                  }

                  Adw.SidebarItem trending_item {
                    title: _("Trending");
                    icon-name: "dailies-trending-symbolic";
                  }
                }

                // One item per category, appended at startup.
                Adw.SidebarSection categories_section {
                  title: _("Categories");
                }
              };
            }
          };

          content: Adw.NavigationPage content_page {
            title: _("Favorites");

            Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [end]
                MenuButton {
                  icon-name: "view-sort-descending-symbolic";
                  tooltip-text: _("Sort");
                  menu-model: sort_menu;
                }

                [end]
                ToggleButton search_button {
                  icon-name: "system-search-symbolic";
                  tooltip-text: _("Search");
                }
              }

              // Typing anywhere in the library starts a search. The query is kept across sections.
              [top]
              SearchBar search_bar {
                search-mode-enabled: bind search_button.active bidirectional;
                key-capture-widget: split_view;
                notify::search-mode-enabled => $on_search_mode_changed();

                child: Adw.Clamp {
                  maximum-size: 500;

                  child: SearchEntry search_entry {
                    placeholder-text: _("Search games");
                    hexpand: true;
                    search-changed => $on_search_changed();
                  };
                };
              }

              [top]
              Adw.Banner stale_banner {}

              [top]
              Adw.Banner first_run_banner {
                title: _("Games open inside Dailies. You can change this in Preferences.");
                button-label: _("Preferences");
                action-name: "app.preferences";
                button-clicked => $on_first_run_banner_clicked();
              }

              content: Stack content_stack {
                transition-type: crossfade;

                StackPage {
                  name: "grid";

                  child: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Adw.ClampScrollable {
                      maximum-size: 1400;
                      tightening-threshold: 1200;

                      child: GridView grid_view {
                        name: "grid";
                        min-columns: 1;
                        max-columns: 5;
                        single-click-activate: true;
                        enable-rubberband: false;
                        margin-top: 12;
                        margin-bottom: 12;
                        margin-start: 12;
                        margin-end: 12;
                        activate => $on_game_activated();

                        // The list item takes the focus, so the arrow keys move between games and Enter opens one;
                        // screen readers read its label and description.
                        factory: BuilderListItemFactory {
                          template ListItem {
                            accessible-label: bind template.item as <$DailiesGameObject>.name;
                            accessible-description: bind template.item as <$DailiesGameObject>.caption;

                            child: $DailiesGameTile {
                              game: bind template.item as <$DailiesGameObject>;
                            };
                          }
                        };
                      };
                    };
                  };
                }

                StackPage {
                  name: "empty-favorites";

                  child: Adw.StatusPage {
                    icon-name: "dailies-non-starred-symbolic";
                    title: _("No Favorites Yet");
                    description: _("Press the star on any game to pin it here");

                    child: Button {
                      label: _("Browse Popular Games");
                      halign: center;
                      action-name: "win.show-section";
                      action-target: "'popular'";

                      styles [
                        "pill",
                        "suggested-action",
                      ]
                    };
                  };
                }

                StackPage {
                  name: "no-results";

                  child: Adw.StatusPage {
                    icon-name: "system-search-symbolic";
                    title: _("No Games Found");
                    description: _("Try a different search");
                  };
                }

                StackPage {
                  name: "empty-section";

                  child: Adw.StatusPage empty_section_page {
                    title: _("Nothing Here Yet");

                    child: Button {
                      label: _("Suggest a game on GitHub");
                      halign: center;
                      clicked => $on_suggest_clicked();

                      styles [
                        "pill",
                      ]
                    };
                  };
                }
              };
            }
          };
        }
      }

      // The in-app browser page is pushed at runtime (#46).
    }
  };
}

menu primary_menu {
  section {
    item (_("_Refresh Game List"), "app.refresh")
  }

  section {
    item (_("_Preferences"), "app.preferences")
    item (_("_Keyboard Shortcuts"), "app.shortcuts")
    item (_("_About Dailies"), "app.about")
  }
}

menu sort_menu {
  section {
    item (_("_Default"), "win.sort-mode", "default")
    item (_("_Name"), "win.sort-mode", "name")
    item (_("D_ifficulty"), "win.sort-mode", "difficulty")
  }
}
