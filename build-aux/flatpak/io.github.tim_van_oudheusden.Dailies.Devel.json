{
  "id": "io.github.tim_van_oudheusden.Dailies.Devel",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "dailies",
  "tags": ["devel"],
  "desktop-file-name-suffix": " (Devel)",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "dailies",
      "buildsystem": "meson",
      "builddir": true,
      "run-tests": true,
      "config-opts": ["-Dprofile=development"],
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
