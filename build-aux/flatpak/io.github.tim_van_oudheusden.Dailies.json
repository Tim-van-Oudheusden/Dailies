{
  "id": "io.github.tim_van_oudheusden.Dailies",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "dailies",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "dailies",
      "buildsystem": "meson",
      "builddir": true,
      "config-opts": [
        "-Dprofile=release"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Tim-van-Oudheusden/Dailies.git",
          "commit": "ae370ed805bfb1515a62e3d06c3df2c69b953d76",
          "x-checker-data": {
            "type": "git",
            "tag-pattern": "^v([\\d.]+)$",
            "version-scheme": "semantic",
            "is-main-source": true,
            "is-important": true
          },
          "tag": "v0.3.0"
        }
      ]
    }
  ]
}
